# =============================================================================
# GitHub Analytics Pro - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SETTINGS
# -----------------------------------------------------------------------------

# GitHub Personal Access Token (Required)
# Get your token from: https://github.com/settings/tokens
# Required scopes: read:user, public_repo, read:org
GITHUB_TOKEN=your_github_personal_access_token_here

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Debug Mode (True/False)
DEBUG=False

# Secret Key for Flask sessions (generate a random string for production)
SECRET_KEY=your_secret_key_here_change_in_production

# Maximum worker threads for parallel processing
MAX_WORKERS=10

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Database URL
# SQLite (default): sqlite:///github_analytics.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///github_analytics.db

# -----------------------------------------------------------------------------
# CACHING CONFIGURATION
# -----------------------------------------------------------------------------

# Cache Type: simple, redis, filesystem
CACHE_TYPE=simple

# Redis URL (required if CACHE_TYPE=redis)
CACHE_REDIS_URL=redis://localhost:6379/0

# Cache timeout in seconds (default: 1 hour)
CACHE_TIMEOUT=3600

# Maximum number of cached items
MAX_CACHE_ITEMS=100

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

# Rate limit storage URL
# Options: memory://, redis://localhost:6379
RATELIMIT_STORAGE_URL=memory://

# Default rate limit (requests per time period)
RATELIMIT_DEFAULT=100 per hour

# -----------------------------------------------------------------------------
# CORS SETTINGS
# -----------------------------------------------------------------------------

# Allowed CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# ADVANCED FEATURES
# -----------------------------------------------------------------------------

# Enable data export functionality (True/False)
ENABLE_ANALYTICS_EXPORT=True

# Enable user comparison mode (True/False)
ENABLE_COMPARISON_MODE=True

# Enable historical data tracking (True/False)
ENABLE_HISTORICAL_TRACKING=True

# Maximum number of users that can be compared at once
MAX_COMPARISON_USERS=5

# -----------------------------------------------------------------------------
# CHART AND VISUALIZATION SETTINGS
# -----------------------------------------------------------------------------

# Default chart theme: dark, light
DEFAULT_CHART_THEME=dark

# Enable advanced charts (True/False)
ENABLE_ADVANCED_CHARTS=True
